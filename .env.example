# =============================================================================
# AI Workforce OS — Environment Variables Example
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Supabase (get from Supabase project settings) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth (future) ---
# AUTH_SECRET=

# --- Evolution API (WhatsApp) ---
# One global instance used by all units (unit gets its own instance auto-named as "unit-{slug}")
EVOLUTION_API_URL=https://evolution.yourserver.com
EVOLUTION_API_KEY=your_global_api_key

# --- Meta Lead Ads webhook ---
META_WEBHOOK_VERIFY_TOKEN=your_random_verify_token
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token

# --- Generic lead intake ---
INTAKE_SECRET=your_random_intake_secret

# --- Meta Business Manager da Alizo (Conteúdo/Social + Meta Ads) ---
# Cliente compartilha a Página/conta de anúncio como Parceiro deste BM — sem gerar token.
# Ver docs/setup/traffic-apis-setup.md
META_BUSINESS_MANAGER_ID=your_alizo_business_manager_id
META_SYSTEM_USER_TOKEN=your_alizo_system_user_token

# --- Google Ads (Traffic Specialist) ---
# App OAuth + developer token da Alizo, compartilhados por todas as contas
# vinculadas à MCC (login-customer-id). Ver docs/setup/traffic-apis-setup.md
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token
GOOGLE_ADS_CLIENT_ID=your_google_oauth_client_id
GOOGLE_ADS_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_alizo_mcc_refresh_token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your_alizo_mcc_customer_id
