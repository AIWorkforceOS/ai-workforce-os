{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm turbo run build --filter=@ai-workforce-os/web",
  "outputDirectory": "apps/web/.next",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/follow-up",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/traffic",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/recruiter",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/appointment-reminders",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/content",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/content-publish",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/seo",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/prospecting",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/prospecting-midday",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/prospecting-afternoon",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/smarter-franquia-crm-sync",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/whatsapp-health-check",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/manager-agenda-digest",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/receptionist-care",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/provider-budget-alerts",
      "schedule": "15 17 * * *"
    },
    {
      "path": "/api/cron/facilit-sync",
      "schedule": "0 12,14,16,18,20,22 * * *"
    },
    {
      "path": "/api/cron/db-backup",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/quote-jobs",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/kai-supervisor",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/partner-webhooks",
      "schedule": "*/5 * * * *"
    }
  ]
}
