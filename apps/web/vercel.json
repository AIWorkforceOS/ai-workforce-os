{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@ai-workforce-os/web",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/follow-up",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/traffic",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/recruiter",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/appointment-reminders",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/content",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/seo",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/prospecting",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/prospecting-midday",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/prospecting-afternoon",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/smarter-franquia-crm-sync",
      "schedule": "0 14 * * *"
    }
  ]
}
