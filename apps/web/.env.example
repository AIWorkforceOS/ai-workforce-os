# =============================================================================
# AI Workforce OS — Web App Environment Variables Example
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Supabase (get from Supabase project settings) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (Agente SDR + chat Kai da landing page) ---
OPENAI_API_KEY=sk-...

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL=https://sua-instancia-evolution.com
EVOLUTION_API_KEY=sua_api_key_aqui

# --- Twilio (SMS — canal alternativo ao WhatsApp, ex.: unidades nos EUA) ---
# Cada empresa cliente normalmente tem sua própria conta Twilio (registro
# A2P 10DLC é por empresa) — estes env vars são só um fallback global;
# o normal é preencher units.twilio_account_sid/auth_token/phone_number
# via /dashboard/messaging/connect.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Google Maps Platform ---
GOOGLE_MAPS_API_KEY=sua_api_key_aqui

# --- SEO — Google Search Console (login OAuth, dados reais de busca) ---
# Ver docs/setup/seo-search-console-setup.md. Cliente OAuth dedicado (Aplicativo
# da Web), diferente do GOOGLE_ADS_CLIENT_ID do módulo de Tráfego. Sem estas
# duas, a conexão fica indisponível de forma graciosa (botão mostra aviso).
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=

# --- SEO — rastreamento de posição no Google (SerpApi, opcional/pago) ---
# Sem esta chave, o funcionário de SEO continua funcionando 100% (auditoria +
# conteúdo + Search Console) — só o rank tracking via SerpApi fica pulado.
SERP_API_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=re_...
EMAIL_FROM_DOMAIN=smarterestagios.com.br

# --- Email de entrada (resposta do lead por e-mail) ---
# Exige um domínio/subdomínio DEDICADO com MX apontando para o Resend
# (Dashboard → Domains → Receiving) — recomendado um subdomínio próprio,
# ex. "inbound.smarterestagios.com.br", pra não conflitar com o e-mail que
# já existir no domínio principal. É configuração da PLATAFORMA (Alizo),
# não do domínio do cliente. Sem isso preenchido, e-mail de entrada fica
# desativado e o reply-to volta a ser o e-mail real da unidade (comportamento
# antigo, sem captura pelo agente).
EMAIL_INBOUND_DOMAIN=
# Signing secret do webhook (Resend → Webhooks → Signing Secret), usado
# pra verificar que a requisição realmente veio do Resend.
RESEND_WEBHOOK_SECRET=

# --- Webhook de intake de leads ---
# Token global (opcional — cada unidade tem o próprio token em units.intake_token)
INTAKE_SECRET=

# --- Cron de follow-up automático (Vercel Cron) ---
# Obrigatório em produção: a Vercel envia este valor como Bearer token
CRON_SECRET=
# Dias sem resposta antes do follow-up automático (padrão: 3)
FOLLOW_UP_AFTER_DAYS=3
# Máximo de follow-ups automáticos por lead (padrão: 2)
FOLLOW_UP_MAX=2
# Teto de envios por unidade por execução do cron (padrão: 10)
FOLLOW_UP_MAX_PER_UNIT=10

# --- Pagamentos (Asaas BR / Stripe US) ---
# As API keys/secret keys NÃO ficam aqui — ficam em payment_gateway_settings
# (Super Admin → /dashboard/sales/payments), por região. Só o que precisa ser
# env var (config global, não credencial por região) mora aqui:
# 'sandbox' usa a API de testes da Asaas; qualquer outro valor (ou vazio) usa
# produção — cuidado, produção cobra de verdade.
ASAAS_ENV=
# Token de autenticação do webhook Asaas (Configurações → Webhooks → Token de
# autenticação, no painel da Asaas) — precisa ser o MESMO valor nos dois
# lugares. Sem isso, todo webhook do Asaas é rejeitado (assinatura inválida).
ASAAS_WEBHOOK_TOKEN=
# Signing secret do webhook do Stripe (Dashboard → Developers → Webhooks).
STRIPE_WEBHOOK_SECRET=
# Price IDs da assinatura recorrente no Stripe (Dashboard → Product catalog).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# --- CRM de Franquias da Smarter (leads de quem quer abrir franquia) ---
# Integração de rede (não por unidade, diferente de units.smarter_crm_partner_token):
# gerada uma vez pela franqueadora na aba Integração do Sistema Smarter, escopo
# "franquia_crm". Sem isso preenchido, o cron de sincronização não faz nada
# (2026-08-14, ver lib/sales/smarter-crm.ts).
SMARTER_FRANQUIA_CRM_TOKEN=
# Unit id da Alizo que vai "possuir" esses leads pra follow-up (hoje: Smarter
# Matriz — é quem tem relação comercial real com a franqueadora).
SMARTER_FRANQUIA_CRM_UNIT_ID=
